+    Math.max(16, Math.round(width * scale)),
+    Math.max(16, Math.round(height * scale)),
+  ];
+  return {
+    flow: [
+      Math.max(8, Math.round(paint[0] * tier.flowScale)),
+      Math.max(8, Math.round(paint[1] * tier.flowScale)),
+    ],
+    paint,
+    pixel: paint[0] / width,
+  };
