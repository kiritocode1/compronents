{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!src/app/globals.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noGlobalIsNan": "off"
          },
          "style": { "noNonNullAssertion": "off" },
          "correctness": { "useExhaustiveDependencies": "off" },
          "a11y": {
            "noLabelWithoutControl": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "noSvgWithoutTitle": "off",
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["src/registry/**"],
      "linter": {
        "rules": {
          "performance": { "noImgElement": "off" },
          "correctness": { "useExhaustiveDependencies": "off" },
          "style": { "noNonNullAssertion": "off" },
          "suspicious": {
            "noArrayIndexKey": "off",
            "useIterableCallbackReturn": "off"
          },
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "useFocusableInteractive": "off",
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
