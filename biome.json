{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!src/app/globals.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/ui/**",
        "src/components/animate-ui/**",
        "src/hooks/use-controlled-state.tsx",
        "src/lib/get-strict-context.tsx"
      ],
      "linter": {
        "rules": {
          "security": { "noDangerouslySetInnerHtml": "off" },
          "suspicious": {
            "noExplicitAny": "off",
            "noGlobalIsNan": "off",
            "noArrayIndexKey": "off"
          },
          "style": { "noNonNullAssertion": "off", "useTemplate": "off" },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "noUnusedImports": "off"
          },
          "a11y": {
            "noLabelWithoutControl": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "noSvgWithoutTitle": "off",
            "noStaticElementInteractions": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["src/registry/**"],
      "linter": {
        "rules": {
          "performance": { "noImgElement": "off" },
          "correctness": { "useExhaustiveDependencies": "off" },
          "style": { "noNonNullAssertion": "off" },
          "suspicious": {
            "noArrayIndexKey": "off",
            "useIterableCallbackReturn": "off"
          },
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "useFocusableInteractive": "off",
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/registry/house-of-epochs-page/source/**",
        "src/registry/house-of-epochs-page/*.css"
      ],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": ["scripts/gen-grain-shaders.mjs"],
      "linter": {
        "rules": { "suspicious": { "noTemplateCurlyInString": "off" } }
      }
    }
  ]
}
